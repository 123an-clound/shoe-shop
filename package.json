    "gen:images": "tsx scripts/upload-images.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "test:security:storage": "node --import tsx tests/security-storage-live.mjs",
    "test:security:deployment": "node tests/security-deployment-live.mjs",
    "backup:run": "node scripts/backup/run.mjs",
    "backup:verify": "node scripts/backup/run.mjs --verify-latest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
