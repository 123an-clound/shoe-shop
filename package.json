    "motion": "^13.1.1",
    "next": "^16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
